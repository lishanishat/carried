# Client-side Base44 settings read by src/lib/app-params.js.
# These are public app identifiers, not secrets: they are compiled into the
# browser bundle. Base44 supplies them automatically when it builds or previews
# the app. For a local build, copy the values from your own Base44 app
# (Base44 editor -> app settings / dashboard) into a file named .env.

# The Base44 app ID (24 hex characters). Without it, API calls fail.
VITE_BASE44_APP_ID=your_base44_app_id

# The app's base URL on Base44, e.g. https://your-app.base44.app
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app

# Optional. Pins a backend functions version; leave empty for the default.
VITE_BASE44_FUNCTIONS_VERSION=
