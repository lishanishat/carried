# dependencies
node_modules
.pnp
.pnp.*

# build output
# The Cloudflare Vite plugin emits dist/{client,server} plus the .wrangler/deploy
# redirect the Base44 publish reads; every build regenerates all of them.
dist
build
.wrangler
.tanstack
.vite

# generated by the TanStack Router plugin on every dev/build run — never edit
src/routeTree.gen.ts

# environment / secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

*.pem
*.key

# local link to a Base44 app, written by `base44 link`
base44/.app.jsonc

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# test / coverage output
coverage
.nyc_output

# editor and OS files
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo
*.swn
.DS_Store
._*
Thumbs.db
desktop.ini
